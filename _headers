# The filenames carry no content hash, so index.html and app.js must never
# disagree about which deploy they are from. no-cache keeps them in the
# browser's cache but revalidates every time: a 304 costs a round trip and no
# body, and a deploy can never be half-applied.
/*.css
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/verbs.txt
  Cache-Control: no-cache
