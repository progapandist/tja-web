# Every asset URL in index.html carries a content hash, so a URL that resolves
# today will never mean anything else. index.html itself is left on Cloudflare's
# default, which revalidates on every load.
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/verbs.txt
  Cache-Control: public, max-age=31536000, immutable
/verbs.ru.txt
  Cache-Control: public, max-age=31536000, immutable
